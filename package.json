{
  "name": "mobile-expo",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web --port 8085",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/models.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write app src tests playwright.config.ts package.json app.json tsconfig.json",
    "format:check": "prettier --check app src tests playwright.config.ts package.json app.json tsconfig.json"
  },
  "dependencies": {
    "@designcodeio/threeui": "^1.2.0",
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.23",
    "expo-camera": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-router": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.4",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.28.2"
}
