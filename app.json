{
  "expo": {
    "name": "FETD3D",
    "slug": "rag-assistant",
    "scheme": "fire3d",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F3EA",
    "android": {
      "package": "com.fet3d.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": { "bundler": "metro", "output": "single", "name": "FETD3D" },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        { "photosPermission": "Cho phép Fire3D chọn ảnh đại diện từ thư viện." }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Fire3D dùng camera để quét QR tòa nhà.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
