{
  "expo": {
    "name": "FET3D",
    "slug": "fet3d",
    "owner": "lazzymoney",
    "version": "1.0.0",
    "extra": {
      "eas": { "projectId": "98768196-bf44-40f1-b245-0839c97e5056" }
    },
    "scheme": ["fet3d", "fire3d"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#141719",
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.fet3d.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F3EA"
      },
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "fet3d.io.vn", "pathPrefix": "/qr/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "FET3D",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#141719",
          "dark": {
            "image": "./assets/images/logo-mark.png",
            "backgroundColor": "#141719"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Fire3D chọn ảnh đại diện từ thư viện."
        }
      ],
      ["expo-camera", { "cameraPermission": "Cho phép Fire3D quét mã QR của Building." }],
      "expo-dev-client",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-build-properties",
        { "android": { "minSdkVersion": 29, "buildArchs": ["arm64-v8a"] } }
      ],
      "./plugins/withUnityLibrary",
      "./plugins/withWindowsCMake",
      "./plugins/withAndroidReleaseSigning"
    ]
  }
}
